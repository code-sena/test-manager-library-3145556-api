DB_PASSWORD=library_secret
DB_SCHEMA=library

JWT_SECRET=your-jwt-secret-here-min-32-chars

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

CORS_ORIGIN=http://localhost:5173

CLOCK_OFFSET_DAYS=0
