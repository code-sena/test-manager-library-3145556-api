APP_NAME="Manager Library"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:generate-with-php-artisan-key-generate

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=library
